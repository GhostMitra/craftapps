{
  "hosting": {
    "public": ".",
    "trailingSlash": true,
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "package.json",
      "package-lock.json",
      "**/.*",
      "**/.*/**",
      "**/build/**",
      "**/deps/**",
      "**/examples/**",
      "**/incremental/**",
      "**/*.rlib",
      "**/*.rmeta",
      "**/*.d",
      "**/*.lock",
      "**/*.gz",
      "**/*.br",
      "**/README.md",
      "**/HOSTING.md",
      "**/ATTRIBUTION.md",
      "**/LICENSE*",
      "**/NOTICE",
      "**/.cargo-*-lock",
      "**/.htaccess",
      "scripts/**",
      "versions.json"
    ],
    "headers": [
      {
        "source": "**/*.wasm",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/wasm"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "lightcraft/**/*.wasm",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/wasm"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/javascript"
          }
        ]
      },
      {
        "source": "**/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ]
  }
}
